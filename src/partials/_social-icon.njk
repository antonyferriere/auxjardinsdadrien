{# Local outline icons: inherit link colors in both themes. #}
{% macro socialIcon(name) %}
<svg xmlns="http://www.w3.org/2000/svg" class="icon-social" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% if name == 'facebook' %}
  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
  {% elif name == 'instagram' %}
  <rect x="2" y="2" width="20" height="20" rx="5" />
  <circle cx="12" cy="12" r="4" />
  <path d="M17.5 6.5h.01" />
  {% elif name == 'linkedin' %}
  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
  <rect x="2" y="9" width="4" height="12" />
  <circle cx="4" cy="4" r="2" />
  {% endif %}
</svg>
{% endmacro %}
